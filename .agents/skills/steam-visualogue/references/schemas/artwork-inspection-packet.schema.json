{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artwork-inspection-packet.schema.json",
  "title": "Artwork inspection packet",
  "type": "object",
  "required": ["format", "stage", "packet_id", "run_id", "source_fingerprints", "images", "questions"],
  "properties": {
    "format": {"const": "steam-visualogue-agent-packet"},
    "stage": {"const": "artwork-inspection"},
    "packet_id": {"type": "string"},
    "run_id": {"type": "string"},
    "source_fingerprints": {"type": "object", "additionalProperties": {"type": "string"}},
    "completion_criterion": {"type": "string", "maxLength": 1000},
    "result_schema": {"type": "string"},
    "images": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/image"}},
    "questions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 256}}
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["asset_id", "path", "width", "height", "aspect_ratio", "target_roles"],
      "properties": {"asset_id": {"type": "string"}, "path": {"type": "string", "maxLength": 1024}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "aspect_ratio": {"type": "number", "exclusiveMinimum": 0}, "target_roles": {"type": "array", "maxItems": 8, "items": {"type": "string"}}, "exposure_count": {"type": "integer", "minimum": 0}, "exposure_pages": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
