{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial-curation-result.schema.json",
  "title": "Editorial curation result",
  "type": "object",
  "required": ["format", "stage", "packet_id", "findings"],
  "properties": {
    "format": {"const": "steam-visualogue-agent-result"},
    "stage": {"const": "editorial-curation"},
    "packet_id": {"type": "string"},
    "findings": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "type", "claim", "evidence_ids", "confidence"],
      "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "claim": {"type": "string", "maxLength": 1000}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string"}}, "confidence": {"enum": ["high", "medium", "low"]}, "warnings": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 256}}, "recommended_role": {"type": ["string", "null"], "maxLength": 80}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
